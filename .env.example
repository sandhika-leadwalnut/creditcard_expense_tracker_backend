# --- Database ---
# Local MongoDB:      mongodb://localhost:27017
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# No install / demo:  mongomock://localhost   (in-memory, data is lost on restart)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=expense_tracker

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# First admin user, created automatically on first start
ADMIN_EMAIL=admin@leadwalnut.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Admin
# Only these email domains can be added as users
ALLOWED_EMAIL_DOMAINS=leadwalnut.com,codewalnut.com

# --- Business rules ---
INVOICE_THRESHOLD=10000

# --- Files ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- CORS (frontend URL) ---
CORS_ORIGINS=http://localhost:5173
